{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    // El navegador: `document`, `HTMLElement`, `localStorage`.
    //
    // El `tsconfig.base` declara sólo ES2022 —el dominio no tiene por qué
    // conocer el navegador— y hasta Angular 20 el builder agregaba `dom`
    // por su cuenta. La 21 dejó de hacerlo, así que cada app que corre en
    // un navegador lo pide acá, que además es donde se lee sin adivinar.
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": [],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "outDir": "../../dist/out-tsc/diner-pwa"
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts"],
  // Los tests no entran al bundle: usan los globales de Jest, que no existen
  // en el navegador.
  //
  // Los dos patrones son necesarios: `exclude` se resuelve contra el
  // directorio de este archivo, así que `**/*.spec.ts` no alcanza lo que el
  // `include` trae subiendo con `../../`. Un test dentro de una lib
  // compartida rompía el build de esta app aunque el archivo no fuera suyo.
  "exclude": ["**/*.spec.ts", "../../libs/**/*.spec.ts"]
}
