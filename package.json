{
  "name": "itadaki",
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "ng serve diner-pwa",
    "build": "ng build diner-pwa && ng build kds-web && ng build admin-web && npm run build:api",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "start:kds": "ng serve kds-web --port 4500",
    "start:api": "npm run build:api && node dist/api/apps/api/src/main.js",
    "build:api": "tsc -p apps/api/tsconfig.app.json && tsc-alias -p apps/api/tsconfig.app.json",
    "start:admin": "ng serve admin-web --port 4400",
    "db:up": "docker compose up -d --wait",
    "db:seed": "npm run build:api && node dist/api/apps/api/src/seed.js",
    "db:migrate": "npm run build:api && node dist/api/apps/api/src/migrate-cli.js",
    "db:down": "docker compose down",
    "db:staff": "npm run build:api && node dist/api/apps/api/src/create-staff.js",
    "db:trial": "npm run build:api && node dist/api/apps/api/src/manage-trial.js",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:seed",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "build:comensal": "npm run legal && ng build diner-pwa",
    "build:cocina": "ng build kds-web",
    "build:admin": "npm run legal && ng build admin-web",
    "build:salon": "ng build floor-web",
    "legal": "node scripts/build-legal.mjs",
    "check:despliegue": "node scripts/hace-falta-construir.mjs --check",
    "start:salon": "ng serve floor-web --port 4600",
    "build:landing": "npm run legal && node scripts/build-landing.mjs",
    "video": "node scripts/grabar-flujo.mjs",
    "salon-lleno": "node scripts/salon-lleno.mjs"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/common": "^21.2.21",
    "@angular/compiler": "^21.2.21",
    "@angular/core": "^21.2.21",
    "@angular/platform-browser": "^21.2.21",
    "@angular/router": "^21.2.21",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "express": "^5.2.1",
    "jest": "^30.4.2",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "zone.js": "^0.15.1"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/websockets": "^11.2.1",
    "@sentry/node": "^10.70.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  }
}
